#!/usr/bin/env bash
# polish: CLI for the Polish AI-first shell.
#   polish doctor            check prerequisites and agent CLIs
#   polish agents [--prompt] agent CLI status
#   polish tokens [--prompt] token/cost summary (reads ~/.usage cache only)
#   polish mux <cmd>         multiplexer helpers (tmux/zellij/wezterm)
#   polish theme <cmd>       starship theme helpers
set -u

POLISH_DIR="${POLISH_DIR:-$HOME/.local/share/polish}"
USAGE_DIR="${HOME}/.usage/polish"
VERSION="0.1.0"

usage() {
  sed -n '2,8p' "$0"
  exit "${1:-0}"
}

have() { command -v "$1" >/dev/null 2>&1; }

cmd_doctor() {
  echo "polish $VERSION (POLISH_DIR=$POLISH_DIR)"
  echo "--- shell ---"
  for c in zsh git curl; do
    if have "$c"; then echo "ok      $c ($("$c" --version 2>/dev/null | head -1))"; else echo "missing $c"; fi
  done
  echo "--- prompt/plugins ---"
  for c in starship antidote fnm tmux zellij wezterm; do
    if have "$c"; then echo "ok      $c"; else echo "missing $c (optional)"; fi
  done
  echo "--- agent CLIs ---"
  for c in claude muse codex opencode pi; do
    if have "$c"; then echo "ok      $c ($(command -v "$c"))"; else echo "missing $c (optional)"; fi
  done
  echo "--- token cache ---"
  if [ -f "$USAGE_DIR/daily.json" ]; then
    echo "ok      $USAGE_DIR/daily.json"
  else
    echo "empty   $USAGE_DIR/daily.json (run: polish-tokens-collect)"
  fi
}

cmd_agents() {
  if [ "${1:-}" = "--prompt" ]; then
    # Compact single-token status for starship; quiet when nothing relevant.
    exit 0
  fi
  if [ "${1:-}" = "--prompt-quiet" ]; then
    exit 1
  fi
  for c in claude muse codex opencode pi; do
    if have "$c"; then printf '%-9s %s\n' "$c" "$(command -v "$c")"; else printf '%-9s %s\n' "$c" "not installed"; fi
  done
}

cmd_tokens() {
  if [ "${1:-}" = "--prompt" ]; then
    # Prompt path: read pre-aggregated cache only, never parse logs here.
    if [ -f "$USAGE_DIR/daily.json" ]; then
      python3 -c "import json;print(json.load(open('$USAGE_DIR/daily.json')).get('prompt',''))" 2>/dev/null || true
    fi
    exit 0
  fi
  if [ -f "$USAGE_DIR/daily.json" ]; then
    cat "$USAGE_DIR/daily.json"
  else
    echo "no token data yet (run: polish-tokens-collect)" >&2
    exit 1
  fi
}

cmd_mux() { echo "polish mux: not implemented yet" >&2; exit 1; }
cmd_theme() { echo "polish theme: not implemented yet" >&2; exit 1; }

case "${1:-}" in
  ""|-h|--help) usage 0;;
  --version) echo "polish $VERSION";;
  doctor) cmd_doctor;;
  agents) shift; cmd_agents "$@";;
  tokens) shift; cmd_tokens "$@";;
  mux) shift; cmd_mux "$@";;
  theme) shift; cmd_theme "$@";;
  *) echo "unknown command: $1" >&2; usage 1;;
esac
